# Elbespararen v7 - Environment Variables
# Kopiera denna fil till .env.local och fyll i dina värden

# ===========================================
# OPENAI CONFIGURATION
# ===========================================
# Din OpenAI API-nyckel för GPT-4o Vision
OPENAI_API_KEY=your_openai_api_key_here

# ===========================================
# TELEGRAM BOT (valfritt)
# ===========================================
# Telegram bot token för notifikationer
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID för admin-notifikationer (singel mottagare)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Alternativt: flera mottagare, kommaseparerade eller mellanslag
# Exempel: TELEGRAM_CHAT_IDS=123456789,987654321,11223344
# Om satt används denna variabel före TELEGRAM_CHAT_ID
TELEGRAM_CHAT_IDS=

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# För utveckling: använd mock data (inget värde behövs)
# För produktion: Cloudflare D1 database binding
# DB=your_cloudflare_d1_database_binding

# ===========================================
# APPLICATION CONFIGURATION
# ===========================================
# Miljö (development/production)
NODE_ENV=development

# App URL (för produktion)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# CLOUDFLARE CONFIGURATION (för produktion)
# ===========================================
# Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# Cloudflare API Token
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# ===========================================
# SECURITY & AUTHENTICATION
# ===========================================
# Secret key för sessioner (generera en säker nyckel)
# Generera med: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth credentials
# Skapa på: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth URL (för produktion, sätt till din domän)
NEXTAUTH_URL=http://localhost:3000

# ===========================================
# EMAIL CONFIGURATION (valfritt)
# ===========================================
# För e-postnotifikationer via MailerLite HTTP API
MAILERLITE_API_KEY=your_mailerlite_api_key

# Standard e-postkonfiguration för detta projekt
# För Elchef.se (Sverige): sätt dessa värden
# För Stromsjef.no (Norge): ändra till norska värden i ditt projekt
MAIL_FROM=info@elbespararen.se
MAIL_FROM_NAME=Elchef.se
MAILERLITE_GROUP_NEWSLETTER=169680723602572313
MAILERLITE_GROUP_RECEIPTS=169692592654518080

# Alternativ: Om du delar samma Mailerlite-konto mellan flera länder/projekt,
# kan du konfigurera separata domäner här. Systemet väljer automatiskt rätt domän
# baserat på vilken grupp som används.
# 
# Sverige (Elchef.se) - används om groupId matchar dessa grupper
MAIL_FROM_SE=info@elbespararen.se
MAIL_FROM_NAME_SE=Elchef.se
MAILERLITE_GROUP_NEWSLETTER_SE=169680723602572313
MAILERLITE_GROUP_RECEIPTS_SE=169692592654518080

# Norge (Stromsjef.no) - används om groupId matchar dessa grupper
MAIL_FROM_NO=post@stromsjef.no
MAIL_FROM_NAME_NO=Stromsjef.no
MAILERLITE_GROUP_NEWSLETTER_NO=your_norway_newsletter_group_id
MAILERLITE_GROUP_RECEIPTS_NO=your_norway_receipts_group_id

# Debug/test endpoint controls (optional)
EMAIL_TEST_ENABLED=false
EMAIL_TEST_TOKEN=change-me

# ===========================================
# ANALYTICS (valfritt)
# ===========================================
# Google Analytics
# Aktivera analytics genom att sätta NEXT_PUBLIC_ENABLE_ANALYTICS=true
# Measurement ID (från GA dashboard, format: G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=G-SLJHDTCJJ1
# Property ID för Data API (hittar du i GA Admin > Property Settings, format: 123456789)
GOOGLE_ANALYTICS_PROPERTY_ID=your_property_id_here
# Access Token (alternativ 1: direkt access token från OAuth flow)
GOOGLE_ANALYTICS_ACCESS_TOKEN=your_access_token_here
# Service Account JSON (alternativ 2: service account credentials som JSON-sträng)
# GOOGLE_APPLICATION_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# ===========================================
# STRIPE PAYMENT INTEGRATION
# ===========================================
# Stripe Secret Key (för server-side)
# Hittar du i Stripe Dashboard > Developers > API keys
# Använd test key (sk_test_...) för utveckling, live key (sk_live_...) för produktion
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Publishable Key (för client-side)
# Hittar du i Stripe Dashboard > Developers > API keys
# Använd test key (pk_test_...) för utveckling, live key (pk_live_...) för produktion
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Stripe Webhook Secret
# Skapa en webhook endpoint i Stripe Dashboard > Developers > Webhooks
# Kopiera webhook signing secret och sätt här
# För lokal utveckling: använd Stripe CLI (stripe listen --forward-to localhost:3000/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
# Supabase URL och anon key för autentisering
# Hittar du i Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ===========================================
# FEATURE FLAGS
# ===========================================
# Aktivera/deaktivera funktioner
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_TELEGRAM_NOTIFICATIONS=false
